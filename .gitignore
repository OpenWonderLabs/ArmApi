# ==========================================
# 1. Python 编译与打包
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
wheelhouse/
pip-wheel-metadata/
.pytest_cache/

# ==========================================
# 2. C++/CMake 构建产物
# ==========================================
# 仅忽略名为 build 的文件夹，但不应忽略源码中可能带 build 字样的文件
/build/
**/build_test/
**/build/
/build*/
CMakeFiles/
CMakeCache.txt
CMakeLists.txt.user
Makefile
install/
_deps/

# 精确忽略 CMake 生成的文件，而不是 *.cmake
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake

# ==========================================
# 3. 其他 (Conda, IDE, 系统)
# ==========================================
conda-out/
.conda_devel/
# conda index 生成的本地元数据缓存（构建中间物，使用者与 release 均不需要）
python/conda_channel/**/.cache/
.vscode/
.idea/
.DS_Store
*.log
backup/
.claude/
.omc/
.agents/
.codex/
trajectory_log/